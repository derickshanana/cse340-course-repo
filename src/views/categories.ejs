<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Browse service projects by category to find opportunities that match your interests and skills.</p>

        <ul class="categories-list">
            <% const categoryIcons={ 'Environmental' : '🌿' , 'Educational' : '📚' , 'Community Service' : '🤝'
                , 'Health and Wellness' : '❤️' }; categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>" class="category-card-link">
                        <span class="category-icon">
                            <%= categoryIcons[category.name] || '🌟' %>
                        </span>
                        <strong>
                            <%= category.name %>
                        </strong>
                        <span class="category-arrow">›</span>
                    </a>
                </li>
                <% }); %>
        </ul>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-category">Add a New Category</a></p>
            <% } %>
    </main>

    <%- include('partials/footer') %>