<%- include('partials/header') %>

    <main>
        <div class="detail-header">
            <h1>
                <%= category.name %>
            </h1>
            <p>All service projects in this category.</p>
        </div>

        <% if (projects.length===0) { %>
            <p class="empty-state">No service projects are currently listed under this category.</p>
            <% } else { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <div class="card-content">
                                <strong>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </strong>
                                <span class="meta">
                                    📅 <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' , timeZone: 'UTC' }) %>
                                        &nbsp;|&nbsp;
                                        📍 <%= project.location %>
                                </span>
                                <span class="meta">
                                    🤝 <a href="/organization/<%= project.organization_id %>">
                                        <%= project.organization_name %>
                                    </a>
                                </span>
                            </div>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <p class="back-link"><a href="/categories">&larr; Back to All Categories</a></p>
    </main>

    <%- include('partials/footer') %>