<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-card">
            <h2>Welcome back, <%= name %>!</h2>
            <p><strong>Name:</strong>
                <%= name %>
            </p>
            <p><strong>Username:</strong>
                <%= email %>
            </p>
            <% if (user && user.role_name) { %>
                <p><strong>Role:</strong>
                    <span class="role-badge role-<%= user.role_name %>">
                        <%= user.role_name %>
                    </span>
                </p>
                <% } %>
        </div>

        <%# ── Volunteer Projects ─────────────────────────────────────────────── %>
            <div class="volunteer-dashboard">
                <h2>🙋 My Volunteer Projects</h2>

                <% if (volunteerProjects.length===0) { %>
                    <p class="empty-state">
                        You have not signed up to volunteer for any projects yet.
                        <a href="/projects">Browse upcoming projects</a> to find one!
                    </p>
                    <% } else { %>
                        <ul class="volunteer-list">
                            <% volunteerProjects.forEach(project=> { %>
                                <li class="volunteer-item">
                                    <div class="volunteer-item-info">
                                        <strong>
                                            <a href="/project/<%= project.project_id %>">
                                                <%= project.title %>
                                            </a>
                                        </strong>
                                        <span class="meta">
                                            📅 <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric'
                                                , month: 'long' , day: 'numeric' , timeZone: 'UTC' }) %>
                                                &nbsp;|&nbsp;
                                                📍 <%= project.location %>
                                        </span>
                                        <span class="meta">
                                            🤝 <a href="/organization/<%= project.organization_id %>">
                                                <%= project.organization_name %>
                                            </a>
                                        </span>
                                    </div>
                                    <form action="/dashboard/unvolunteer/<%= project.project_id %>" method="POST"
                                        class="remove-volunteer-form">
                                        <button type="submit" class="btn-remove-volunteer btn-small">
                                            Remove
                                        </button>
                                    </form>
                                </li>
                                <% }); %>
                        </ul>
                        <% } %>
            </div>

            <%# ── Admin Tools ─────────────────────────────────────────────────────── %>
                <% if (user && user.role_name==='admin' ) { %>
                    <div class="admin-panel">
                        <h2>Admin Tools</h2>
                        <ul>
                            <li><a href="/users">View All Registered Users</a></li>
                            <li><a href="/new-organization">Add New Organization</a></li>
                            <li><a href="/new-project">Add New Service Project</a></li>
                            <li><a href="/new-category">Add New Category</a></li>
                        </ul>
                    </div>
                    <% } %>

                        <p class="back-link"><a href="/">&larr; Back to Home</a></p>
    </main>
    <%- include('partials/footer') %>