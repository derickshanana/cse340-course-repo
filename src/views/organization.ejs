<%- include('partials/header') %>

    <main>
        <div class="detail-header org-header">
            <img class="org-logo" src="/images/<%= organizationDetails.logo_filename %>"
                alt="<%= organizationDetails.name %> logo">
            <div>
                <h1>
                    <%= organizationDetails.name %>
                </h1>
                <p class="org-email">✉️ <%= organizationDetails.contact_email %>
                </p>
            </div>
        </div>

        <p>
            <%= organizationDetails.description %>
        </p>

        <h2>Service Projects</h2>
        <% if (projects.length===0) { %>
            <p class="empty-state">No service projects currently listed for this organization.</p>
            <% } else { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <div class="card-content">
                                <strong>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </strong>
                                <span class="meta">
                                    📅 <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' , timeZone: 'UTC' }) %>
                                        &nbsp;|&nbsp;
                                        📍 <%= project.location %>
                                </span>
                            </div>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
                    <p class="back-link"><a href="/organizations">&larr; Back to All Organizations</a></p>
    </main>

    <%- include('partials/footer') %>