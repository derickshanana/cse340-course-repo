<%- include('partials/header') %>

    <main>
        <div class="detail-header">
            <h1>
                <%= project.title %>
            </h1>
        </div>

        <ul class="detail-list">
            <li>
                <div class="card-content">
                    <strong>Description</strong>
                    <p>
                        <%= project.description %>
                    </p>
                </div>
            </li>
            <li>
                <div class="card-content">
                    <strong>📅 Date</strong>
                    <p>
                        <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                            day: 'numeric' , timeZone: 'UTC' }) %>
                    </p>
                </div>
            </li>
            <li>
                <div class="card-content">
                    <strong>📍 Location</strong>
                    <p>
                        <%= project.location %>
                    </p>
                </div>
            </li>
            <li>
                <div class="card-content">
                    <strong>🤝 Partner Organization</strong>
                    <p><a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a></p>
                </div>
            </li>
            <% if (categories && categories.length> 0) { %>
                <li>
                    <div class="card-content">
                        <strong>🏷️ Categories</strong>
                        <div class="tag-list">
                            <% categories.forEach(category=> { %>
                                <a href="/category/<%= category.category_id %>" class="tag">
                                    <%= category.name %>
                                </a>
                                <% }); %>
                        </div>
                    </div>
                </li>
                <% } %>
        </ul>

        <%# ── Volunteer Section (logged-in users only) ───────────────────── %>
            <% if (isLoggedIn) { %>
                <div class="volunteer-section">
                    <% if (volunteering) { %>
                        <p class="volunteer-status">
                            ✅ <strong>You are volunteering for this project!</strong>
                        </p>
                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                            <button type="submit" class="btn-remove-volunteer">
                                Remove myself as a volunteer
                            </button>
                        </form>
                        <% } else { %>
                            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                                <button type="submit" class="btn-volunteer">
                                    🙋 Volunteer for this project
                                </button>
                            </form>
                            <% } %>
                </div>
                <% } %>

                    <%# ── Admin actions ──────────────────────────────────────────────── %>
                        <% if (user && user.role_name==='admin' ) { %>
                            <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
                            <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
                            <% } %>

                                <p class="back-link"><a href="/projects">&larr; Back to Upcoming Projects</a></p>
    </main>

    <%- include('partials/footer') %>