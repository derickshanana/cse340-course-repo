<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are the next five upcoming service opportunities. Click on a project to learn more.</p>

        <% if (projects.length===0) { %>
            <p class="empty-state">No upcoming projects at this time. Check back soon!</p>
            <% } else { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <div class="card-content">
                                <strong>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </strong>
                                <span class="meta">
                                    📅 <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' , timeZone: 'UTC' }) %>
                                        &nbsp;|&nbsp;
                                        📍 <%= project.location %>
                                </span>
                                <span class="meta">
                                    🤝 <a href="/organization/<%= project.organization_id %>">
                                        <%= project.organization_name %>
                                    </a>
                                </span>
                                <p>
                                    <%= project.description %>
                                </p>
                            </div>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <% if (user && user.role_name==='admin' ) { %>
                        <p><a href="/new-project">Add a New Service Project</a></p>
                        <% } %>
    </main>

    <%- include('partials/footer') %>