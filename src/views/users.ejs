<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>All users currently registered in the system.</p>

        <table class="users-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach((u, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= u.name %>
                        </td>
                        <td>
                            <%= u.email %>
                        </td>
                        <td><span class="role-badge role-<%= u.role_name %>">
                                <%= u.role_name %>
                            </span></td>
                        <td>
                            <%= new Date(u.created_at).toLocaleDateString('en-US', { year: 'numeric' , month: 'short' ,
                                day: 'numeric' }) %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

        <p class="back-link"><a href="/dashboard">&larr; Back to Dashboard</a></p>
    </main>
    <%- include('partials/footer') %>